# OpenDART
OPENDART_API_KEY=

# PostgreSQL (로컬 docker compose)
POSTGRES_PORT=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# backend 데이터소스 (호스트에서 ./gradlew bootRun 할 때. 형식: jdbc:postgresql://localhost:<POSTGRES_PORT>/<POSTGRES_DB>)
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# backend JWT (서명 키는 32바이트 이상 필수, 없으면 기동 실패. 만료는 비우면 1h)
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRY=
# backend 첫 관리자 시드 (사번·비밀번호를 함께 넣으면 기동 때 한 번 생성, 비밀번호 8자 이상. 이름은 비우면 "관리자")
ADMIN_EMPLOYEE_NO=
ADMIN_PASSWORD=
ADMIN_NAME=

# OPENAI
OPENAI_API_KEY=
