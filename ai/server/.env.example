INTERNAL_API_KEY=
DB_PATH=
MAX_CONCURRENT_JOBS=
# fake | real. real이면 PIPELINE_ENTRYPOINT(모듈경로:함수명)가 필요하다
PIPELINE_MODE=
PIPELINE_ENTRYPOINT=
# 자료 준비 원본 위치. S3_BUCKET이 있으면 S3, 없으면 FILE_STORAGE_DIR(backend와 같은 폴더)
S3_BUCKET=
AWS_REGION=
FILE_STORAGE_DIR=
# 재무 데이터 적재(#135) 작업 폴더. 값이 있으면 real 모드에서 데이터 적재를 받는다
DATASYNC_DATA_DIR=
# OPENDART_API_KEY(DART API 키)는 이 파일에 두지 않는다. ai/server 설정은 이 키를 읽지 않고, 수집기는 프로세스 환경변수
# 또는 저장소 루트 .env만 읽는다. 로컬은 실행 전에 export, 배포는 컨테이너 환경변수(Secret). docs/backend/datasync.md 3장
FAKE_PIPELINE_MODE=
FAKE_PIPELINE_DELAY_SECONDS=
SHUTDOWN_TIMEOUT_SECONDS=
STORE_RETRY_ATTEMPTS=
STORE_RETRY_DELAY_SECONDS=
PENDING_RETRY_INTERVAL_SECONDS=
LOG_LEVEL=
# 실제 파이프라인용(ai 코드가 직접 읽는다). 값은 ai 담당 이슈에서 정한다
OPENAI_API_KEY=
PARSER_EMBED_MODEL=
HF_TOKEN=
