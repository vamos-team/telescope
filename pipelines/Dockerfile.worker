# 데이터 파이프라인(ingest-worker). 빌드 위치는 저장소 루트: docker build -f pipelines/Dockerfile.worker .
# 작업 껍데기(ai/server)에 파싱·적재 의존성(pipelines/: docling·torch·duckdb 등)을 넣는다.
# 의존성 층을 먼저 설치해 코드만 바뀔 때 다시 받지 않게 한다. 지금은 PIPELINE_MODE=fake로만 동작한다.
# 무시 목록: pipelines/Dockerfile.worker.dockerignore
FROM python:3.12-slim
WORKDIR /app
COPY ai/server/requirements.txt ai/server/requirements.txt
COPY pipelines/requirements.txt pipelines/requirements.txt
RUN pip install --no-cache-dir -r ai/server/requirements.txt -r pipelines/requirements.txt
COPY ai/server/ ai/server/
COPY pipelines/ pipelines/
ENV PYTHONPATH=/app:/app/pipelines
WORKDIR /app/ai/server
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
