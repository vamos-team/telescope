# 파싱만 할 때는 환경변수가 필요 없다. 아래는 bge 단위 힌트(hints.suggest_unit_hints)에 쓰이며 전부 선택 사항이다.
# 이 파일을 .env로 복사해 값을 채운다 (.env는 git에 올리지 말 것).
# 코드는 환경변수 → 실행 폴더의 .env → 이 묶음 폴더의 .env 순으로 값을 찾는다.

# Hugging Face 토큰
HF_TOKEN=

# 다른 모델을 쓸 때만: Hugging Face 저장소 이름 또는 로컬 경로. 비우면 yuniju/dart-bge-base
# UNIVERSAL_PARSER_BGE_MODEL=
