FROM eclipse-temurin:21-jdk AS build
WORKDIR /app
COPY gradlew settings.gradle build.gradle ./
COPY gradle gradle
COPY libs/backend-common/build.gradle libs/backend-common/
COPY services/auth/build.gradle services/auth/
COPY services/canvas/build.gradle services/canvas/
COPY services/research/build.gradle services/research/
RUN printf '%s\n' \
      "allprojects { tasks.register('resolveDependencies') { doLast {" \
      "  configurations.findAll { it.canBeResolved }.each { it.files } } } }" > /tmp/resolve.gradle \
 && ./gradlew --no-daemon -q -I /tmp/resolve.gradle resolveDependencies
COPY libs/backend-common/src libs/backend-common/src
COPY services/auth/src services/auth/src
COPY services/canvas/src services/canvas/src
COPY services/research/src services/research/src
ARG MODULE=research
RUN ./gradlew ":$MODULE:bootJar" -x test --no-daemon \
 && cp "$(ls services/"$MODULE"/build/libs/*.jar | grep -v -- '-plain')" /app/service.jar

FROM eclipse-temurin:21-jre
WORKDIR /app
COPY --from=build /app/service.jar app.jar
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "app.jar"]
